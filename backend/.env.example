DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/Battery

# ---- e-mail (app/services/mailer.py) - leave SMTP_HOST empty to switch e-mail off
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# who is e-mailed when someone signs up (comma-separated)
ACCESS_REQUEST_NOTIFY_TO=
# frontend address used in the review link
APP_BASE_URL=http://localhost:4300

# dev | prod - prod switches off /docs, /redoc and /openapi.json on the backend and the ML service
APP_ENV=dev
